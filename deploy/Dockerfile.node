# starskiff 节点镜像（linux/amd64）。与 Dockerfile.server 同构（web 阶段
# 产物只为 rust-embed 编译 server 侧管理页——节点不嵌入页面，但 workspace
# 统一构建最简单；产物只拷 starskiff）。
#
#   docker build -f deploy/Dockerfile.node -t starskiff .
#
# 用法（默认 proxy 模式，无需特权）：
#   1) 一次性注册（ENTRYPOINT 是 up，enroll 必须 --entrypoint 覆盖）：
#      docker run --rm -it --entrypoint /app/starskiff -v skiff-node:/data starskiff \
#          enroll -c /data/starskiff.json --server https://<server>:24930 --token skk_…
#   2) 长期运行：docker run -d --restart unless-stopped -v skiff-node:/data starskiff
# 推荐在 Linux 宿主上用 --network host：SOCKS（默认 127.0.0.1:1080）、端口
# 转发与 P2P UDP 监听全部直接可用；bridge 网络需 -p 24933:24933 -p
# 24933:24933/udp（被直连），且经管理页把 socksListen 托管为 0.0.0.0:1080
# 并 -p 1080:1080 才能从宿主访问。
# TUN 模式需宿主设备与权限：--device /dev/net/tun --cap-add NET_ADMIN。
FROM node:20-slim AS web
WORKDIR /web
COPY crates/skiff-server/web/package.json crates/skiff-server/web/package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY crates/skiff-server/web/ ./
RUN npm run build

FROM rust:1-alpine AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY tests/ tests/
COPY --from=web /web/dist crates/skiff-server/web/dist
RUN cargo build --release -p skiff-node -q

FROM alpine:3
COPY --from=build /src/target/release/starskiff /app/starskiff
VOLUME /data
WORKDIR /data
ENTRYPOINT ["/app/starskiff", "up", "-c", "/data/starskiff.json"]
